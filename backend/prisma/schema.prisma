// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Role {
  id      Int       @id @default(autoincrement())
  nombre  String    @unique
  Usuario Usuario[]

  @@map("roles")
}

model Usuario {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password_hash    String
  role_id          Int
  activo           Boolean   @default(true)
  created_at       DateTime? @default(now())
  modified_at      DateTime? @updatedAt
  
  Role             Role      @relation(fields: [role_id], references: [id])
  Proveedor        Proveedor[]
  
  // Relations for Cliente
  Cliente          Cliente[] @relation("UsuarioToCliente")
  ClienteCreador   Cliente[] @relation("UsuarioCreaCliente")
  ClienteModificador Cliente[] @relation("UsuarioModificaCliente")

  // Relations for Turno
  TurnoCreador     Turno[]   @relation("UsuarioCreaTurno")
  TurnoModificador Turno[]   @relation("UsuarioModificaTurno")

  Feriado          Feriado[]

  @@map("usuarios")
}

model Proveedor {
  id               Int       @id @default(autoincrement())
  usuario_id       Int
  nombre_negocio   String
  telefono_contacto String?
  create_date      DateTime? @default(now())
  modify_date      DateTime? @updatedAt
  
  Usuario          Usuario   @relation(fields: [usuario_id], references: [id], onDelete: Cascade)
  
  HorarioAtencion  HorarioAtencion[]
  ProveedorServicio ProveedorServicio[]
  ExcepcionHorario  ExcepcionHorario[]
  Turno            Turno[]

  @@map("proveedores")
}

model HorarioAtencion {
  id           Int       @id @default(autoincrement())
  proveedor_id Int
  dia_semana   Int       
  hora_apertura DateTime  
  hora_cierre  DateTime  

  Proveedor    Proveedor @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)

  @@map("horarios_atencion")
}

model Servicio {
  id               Int       @id @default(autoincrement())
  nombre           String    
  duracion_minutos Int
  precio_base      Decimal   
  activo           Boolean   @default(true)
  create_date      DateTime? @default(now())
  modify_date      DateTime? @updatedAt 

  ProveedorServicio ProveedorServicio[]
  Turno            Turno[]

  @@map("servicios")
}

model ProveedorServicio {
  proveedor_id      Int
  servicio_id       Int
  precio_especifico Decimal? 

  Proveedor         Proveedor @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)
  Servicio          Servicio  @relation(fields: [servicio_id], references: [id], onDelete: Cascade)

  @@id([proveedor_id, servicio_id])
  @@map("proveedor_servicios")
}

model Cliente {
  id           Int       @id @default(autoincrement())
  usuario_id   Int
  nombre       String    
  apellido     String?   
  telefono     String?   
  create_date  DateTime? @default(now()) 
  create_by    Int?
  modify_date  DateTime? @updatedAt 
  modify_by    Int?

  Usuario      Usuario   @relation("UsuarioToCliente", fields: [usuario_id], references: [id], onDelete: Cascade)
  Creador      Usuario?  @relation("UsuarioCreaCliente", fields: [create_by], references: [id])
  Modificador  Usuario?  @relation("UsuarioModificaCliente", fields: [modify_by], references: [id])

  Turno        Turno[]

  @@map("clientes")
}

model Feriado {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @unique 
  descripcion String?  
  create_by   Int?

  Usuario     Usuario? @relation(fields: [create_by], references: [id])

  @@map("feriados")
}

model ExcepcionHorario {
  id           Int       @id @default(autoincrement())
  proveedor_id Int
  fecha_inicio DateTime  
  fecha_fin    DateTime  
  motivo       String?   

  Proveedor    Proveedor @relation(fields: [proveedor_id], references: [id], onDelete: Cascade)

  @@map("excepciones_horario")
}

model Turno {
  id                Int       @id @default(autoincrement())
  cliente_id        Int
  proveedor_id      Int
  servicio_id       Int
  fecha_hora_inicio DateTime  
  fecha_hora_fin    DateTime  
  estado            String    @default("PENDIENTE")
  precio_cobrado    Decimal?
  notas             String?   
  
  create_date       DateTime? @default(now()) 
  create_by         Int?
  modify_date       DateTime? @updatedAt 
  modify_by         Int?

  Cliente           Cliente   @relation(fields: [cliente_id], references: [id])
  Proveedor         Proveedor @relation(fields: [proveedor_id], references: [id])
  Servicio          Servicio  @relation(fields: [servicio_id], references: [id])
  
  Creador           Usuario?  @relation("UsuarioCreaTurno", fields: [create_by], references: [id])
  Modificador       Usuario?  @relation("UsuarioModificaTurno", fields: [modify_by], references: [id])
  
  LogsNotificacion  LogNotificacion[]

  @@index([fecha_hora_inicio], name: "idx_turnos_fecha")
  @@index([estado], name: "idx_turnos_estado")
  @@map("turnos")
}

model LogNotificacion {
  id             Int       @id @default(autoincrement())
  turno_id       Int
  tipo_envio     String    
  destinatario   String    
  fecha_registro DateTime? @default(now()) 
  fecha_envio    DateTime? 
  procesado      Boolean?  @default(false)
  intentos       Int?      @default(0) 
  error_mensaje  String?   

  Turno          Turno     @relation(fields: [turno_id], references: [id], onDelete: Cascade)

  @@map("logs_notificaciones")
}
